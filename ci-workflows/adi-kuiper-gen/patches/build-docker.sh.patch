--- a/build-docker.sh
+++ b/build-docker.sh
@@ -27,6 +27,14 @@ fi
 # Build docker image
 docker build --build-arg BASE_IMAGE="${BASE_IMAGE}" -t ${IMAGE_NAME} .

+# Support for CI-provided boot artifacts
+# When BOOT_ARTIFACTS_DIR is set, mount it into the container at /boot-artifacts
+# so that the boot partition stage can use local files instead of downloading
+EXTRA_DOCKER_ARGS=""
+if [[ -n "${BOOT_ARTIFACTS_DIR}" && -d "${BOOT_ARTIFACTS_DIR}" ]]; then
+	EXTRA_DOCKER_ARGS="-v ${BOOT_ARTIFACTS_DIR}:/boot-artifacts:ro"
+	echo "Boot artifacts directory mounted: ${BOOT_ARTIFACTS_DIR}"
+fi
+
 # Run docker container
 # -t: pseudo-TTY allowing interaction with container's shell
 # --privileged: elevanted privileges required by the chroot command
@@ -37,6 +45,7 @@ docker run -t --privileged \
 			-v /dev:/dev \
 			-v /lib/modules:/lib/modules \
 			-v ./kuiper-volume:/kuiper-volume \
+			${EXTRA_DOCKER_ARGS} \
 			-e "DEBIAN_VERSION="${DEBIAN_VERSION}"" \
 			--name ${CONTAINER_NAME} ${IMAGE_NAME} \
 			/bin/bash -o pipefail -c "bash kuiper-stages.sh"
